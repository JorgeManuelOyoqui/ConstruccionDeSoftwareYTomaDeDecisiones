<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Battleship</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>¡Battleship!</h1>
    <button id="startGame">Iniciar Juego</button>
    
    <p id="gameState">Estado: <%= estadoJuego %></p>
    <p id="currentTurn">Turno de: Jugador <%= turnoActual %></p>

    <div class="game-container">
        <% Object.keys(jugadores).forEach(player => { %>
            <div class="player-board">
                <h2>Jugador <%= player %></h2>
                <div id="board<%= player %>" class="board"></div>
            </div>
        <% }); %>
    </div>


    
    <div class="game-container">
        <div class="player-board">
            <h2>Jugador 1</h2>
            <div id="board1" class="board"></div>
        </div>
        <div class="player-board">
            <h2>Jugador 2</h2>
            <div id="board2" class="board"></div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
